# Copy to .env and fill in. The server refuses to start when a required value is missing or too
# short, so nothing here silently falls back to an insecure default.

# Environment: dev | test | production
ENV=dev

# Database — set DATABASE_URL (managed provider), or the POSTGRES_* values (local Docker)
# DATABASE_URL=postgresql://user:password@host:5432/database
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
POSTGRES_DB=emob_dev
POSTGRES_TEST_DB=emob_test
POSTGRES_USER=emob_user
POSTGRES_PASSWORD=emob_pass

# TLS to the database: off (local) | verify (check the certificate) | no-verify (encrypt only).
# Managed Postgres with a self-signed certificate needs no-verify, or paste its CA into DATABASE_SSL_CA.
DATABASE_SSL=off
# DATABASE_SSL_CA="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"

# Passwords: PASSWORD_PEPPER is required and must be at least 32 characters.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
PASSWORD_PEPPER=
SALT_ROUNDS=10

# JWT: TOKEN_SECRET is required and must be at least 32 characters (generate it the same way).
# Access tokens cannot be revoked, so keep them short-lived; the refresh cookie carries the session.
TOKEN_SECRET=
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY_DAYS=7

# Where the browser may send the refresh cookie. Defaults to 'strict' locally and 'none' in
# production, where the frontend and the API sit on different sites. Set it to 'strict' only when
# both are served from one site; 'none' requires ENV=production, which is what sets Secure.
REFRESH_COOKIE_SAMESITE=

# Server
PORT=4000
# Comma-separated list of browser origins allowed to call the API
ALLOWED_ORIGIN=http://localhost:4200
# Absolute origin of this API, used to build file download URLs. Leave empty when the web app
# reaches the API through the same origin (the dev proxy, or one reverse proxy for both).
PUBLIC_BASE_URL=
# Number of proxies in front of the app (Railway and similar: 1). It decides which IP the rate
# limiter and the audit log record.
TRUST_PROXY=1
LOG_LEVEL=info

# Limits (optional)
API_RATE_LIMIT=1000
AUTH_RATE_LIMIT=30
JSON_BODY_LIMIT=1mb
UPLOAD_MAX_FILE_SIZE_MB=20
UPLOAD_MAX_FILES=10

# Days an audit entry is kept before the daily cleanup deletes it (optional)
AUDIT_LOG_RETENTION_DAYS=90

# ---------------------------------------------------------------------------------------------
# File storage
#   local — files are written under STORAGE_LOCAL_DIR (development, no account needed)
#   r2    — files are written to a Cloudflare R2 bucket (fill in the four R2_* values below)
# ---------------------------------------------------------------------------------------------
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=storage

# Cloudflare R2 — dashboard > R2 > Manage API tokens. Placeholders are rejected at startup when
# STORAGE_DRIVER=r2, so a half-filled block cannot reach the bucket.
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET=your_r2_bucket_name
# Optional: only for a jurisdiction-specific endpoint, e.g. https://<account>.eu.r2.cloudflarestorage.com
R2_ENDPOINT=

# GraphQL tooling: schema introspection and the bundled Altair explorer at /altair
GRAPHQL_INTROSPECTION=true
ALTAIR_ENABLED=true

# Demo workspace. POST /api/v1/auth/demo signs a visitor in as DEMO_USERNAME without a password,
# which is what lets the web app open straight on the experiments page. Set DEMO_LOGIN_ENABLED=false
# to require a real login. New registrations join DEMO_COMPANY_NAME.
DEMO_LOGIN_ENABLED=true
DEMO_USERNAME=demo
DEMO_COMPANY_NAME=BANPU NEXT

# Seed accounts — used only by `npm run seed`. Leave a password empty and the seed generates one
# and prints it once.
DEMO_PASSWORD=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Planning simulation: how long a submitted experiment waits in the queue and then "runs"
SOLVER_QUEUE_DELAY_MS=4000
SOLVER_RUN_DELAY_MS=8000
# Optional OSRM server for road-following route lines, e.g. https://router.project-osrm.org
# (the public demo server is rate limited). Empty = straight lines with estimated road distance.
OSRM_URL=
